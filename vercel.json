{
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(webp|png|svg|jpg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(.*)\\.(js|pdf)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
